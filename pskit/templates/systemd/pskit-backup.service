[Unit]
Description=pskit encrypted backup
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
ExecStart={{pskit}} backup run
Slice={{backup_slice}}
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=20
MemoryHigh=2G
MemoryMax=3G
TimeoutStartSec=6h
PrivateTmp=yes
